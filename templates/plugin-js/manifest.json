{
  "manifestVersion": 1,
  "id": "org.example.word-count",
  "name": "Word count",
  "version": "1.0.0",
  "publisher": "Example",
  "description": "Counts the words in the open project's TeX files. A starting point for Scribyra plugins.",
  "api": 1,
  "main": "main.js",
  "permissions": {
    "project.read": {"files": ["*.tex"]},
    "ui.dialog": true,
    "ui.command": true
  },
  "contributes": {
    "commands": [
      {"id": "count", "label": "Word count", "hint": "Words per TeX file"}
    ]
  }
}
