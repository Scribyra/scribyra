+// THROWAWAY R1 PROTOTYPE, not a released contract. A page-level convenience
+// adapter over the same command host, compile path and diagnostics as the UI.
+// It is not a security boundary: any script in this origin already has this power.
+import {projectCommands} from './commands.js';
+export class AgentOrigin {}
+export const LIMITS=Object.freeze({diagnosticsPage:50,fieldChars:400,detailChars:1000,readLines:200,readChars:16384,patchEdits:20,patchChars:65536,waitMs:600000});
+const failure=(code,message)=>Object.assign(new Error(message),{code});
+const clip=(text,max)=>{const s=String(text??'');if(s.length<=max)return s;const cut=/[\uD800-\uDBFF]/.test(s[max-1])?max-1:max;return s.slice(0,cut)+'…';};
+const bounded=(value,fallback,max,name)=>{if(value===undefined)return fallback;if(!Number.isInteger(value)||value<0||value>max)throw failure('invalid_request',`${name} must be an integer from 0 to ${max}.`);return value;};
+const DESCRIPTION=Object.freeze({apiVersion:1,status:'prototype',limits:LIMITS,methods:{
+ getStatus:'{} → name, fileCount, activeFile, mainFile, busy, runId, saved, build',
+ compile:'{projectId?,waitMs?} → build; status "running" if waitMs elapses, then poll getStatus',
+ cancelCompile:'{runId} → {cancelled}; only a build this API started',
+ getDiagnostics:'{severity?,offset?,limit?,detail?} → {total,items,nextOffset,jobId,sourceRevision,stale}',
+ readSource:'{fileId|path,startLine?,endLine?} or {fileId|path,line,context?} → text, startOffset, totalLines',
+ revealSource:'{fileId|path,line} → moves the visible editor selection',
+ patchSource:'{expectedRevision,requestId?,edits:[{fileId|path,find,replace}|{fileId,start,end,before,after}]} → receipt',
+},errors:'Failures resolve {ok:false,error:{code,message}}. Treat unknown codes as failure.'});
+export function agentApi({session,compile,isBusy,reveal,notify,beginMutation=()=>{},endMutation=()=>{}}){
+ let host,hostDoc,run=null,runs=0;
+ function current(){
+  const s=session();if(!s)throw failure('project_closed','No project is open in this tab.');
+  if(hostDoc!==s.doc){host?.close();hostDoc=s.doc;host=projectCommands({doc:s.doc,projectId:s.projectId,capabilities:['read','write'],isActive:()=>session()?.doc===s.doc,origin:new AgentOrigin()});}
+  return{...s,host};
+ }
+ const header=()=>{const s=session();return{version:1,projectId:s?.projectId??null,revision:s&&hostDoc===s.doc?host.revision():null};};
+ const wrap=fn=>async(args={})=>{
+  try{if(args===null||typeof args!=='object'||Array.isArray(args))throw failure('invalid_request','Arguments must be an object.');if(args.projectId!==undefined&&args.projectId!==session()?.projectId)throw failure('permission_denied','This tab has a different project open.');const value=await fn(args);return{...header(),ok:true,value};}
+  catch(error){return{...header(),ok:false,error:{code:error.code||'operation_failed',message:clip(error.message||error,LIMITS.fieldChars)}};}
+ };
+ const read=(c,command,expected)=>c.host.run(command,expected);
+ function resolve(c,{fileId,path}){
+  const file=read(c,{op:'project.inspect'}).files.find(f=>fileId?f.id===fileId:f.path===path);
+  if(!file||file.folder)throw failure('not_found','File not found in this project.');
+  if(file.binary)throw failure('invalid_request','This is a binary file.');return file;
+ }
+ function buildSummary(c,result=c.lastCompile){
+  if(!result||result.projectId!==c.projectId)return null;
+  const issues=c.issues(),count=level=>issues.filter(i=>i.severity===level).length;
+  return{status:result.errorType==='AbortError'?'cancelled':result.success?'ok':'fail',jobId:result.jobId,sourceRevision:result.sourceRevision,stale:result.sourceRevision!==c.host.revision(),pages:result.success?c.pages():0,errors:count('error'),warnings:count('warning'),durationMs:result.durationMs===undefined?null:Math.round(result.durationMs)};
+ }
+ return Object.freeze({
+  describe:()=>DESCRIPTION,
+  getStatus:wrap(()=>{
+   const c=current(),inspected=read(c,{op:'project.inspect'}),byId=id=>{const f=inspected.files.find(n=>n.id===id);return f?{id:f.id,path:f.path}:null;};
+   return{name:clip(inspected.metadata.name,160),fileCount:inspected.files.filter(f=>!f.folder).length,activeFile:byId(c.activeId()),mainFile:byId(inspected.metadata.mainFile),busy:isBusy(),runId:run?.id??null,saved:c.saved(),build:buildSummary(c)};
+  }),
+  compile:wrap(async({waitMs})=>{
+   const c=current();
+   const wait=bounded(waitMs,LIMITS.waitMs,LIMITS.waitMs,'waitMs');
+   if(run||isBusy())throw failure('browser_busy','A build is already running. Poll getStatus.');
