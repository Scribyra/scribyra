+  }),
+  cancelCompile:wrap(({runId})=>{if(!run||run.id!==runId)return{cancelled:false};run.controller.abort();return{cancelled:true};}),
+  getDiagnostics:wrap(({severity,offset,limit,detail})=>{
+   const c=current(),build=buildSummary(c);if(severity!==undefined&&!['error','warning','info'].includes(severity))throw failure('invalid_request','Unknown severity.');
+   const logLine=Number(String(c.log()).match(/^l\.(\d+)/m)?.[1])||undefined,start=bounded(offset,0,1e6,'offset'),size=bounded(limit,10,LIMITS.diagnosticsPage,'limit'),issues=c.issues().filter(i=>!severity||i.severity===severity);
+   return{total:issues.length,offset:start,nextOffset:start+size<issues.length?start+size:null,jobId:build?.jobId??null,sourceRevision:build?.sourceRevision??null,stale:build?.stale??null,items:issues.slice(start,start+size).map(i=>({severity:i.severity,code:clip(i.code,80),summary:clip(i.summary,LIMITS.fieldChars),...(i.file?{file:clip(i.file,LIMITS.fieldChars)}:{}),...(i.line?{line:i.line}:{}),...(!i.line&&i.severity==='error'&&logLine?{logLine}:{}),...(detail?{detail:clip(i.detail,LIMITS.detailChars),action:clip(i.action,LIMITS.fieldChars)}:{})}))};
+  }),
+  readSource:wrap(({fileId,path,startLine,endLine,line,context,expectedRevision})=>{
+   const c=current(),file=resolve(c,{fileId,path}),text=read(c,{op:'file.read',id:file.id},expectedRevision).content,lines=text.split('\n'),total=lines.length;
+   const span=bounded(context,5,LIMITS.readLines>>1,'context'),from=Math.max(1,line?bounded(line,1,total,'line')-span:bounded(startLine,1,total,'startLine')||1);
+   let to=Math.min(total,line?line+span:bounded(endLine,Math.min(total,from+49),total,'endLine'));if(to<from)throw failure('invalid_request','endLine precedes startLine.');
+   let truncated=to-from+1>LIMITS.readLines;if(truncated)to=from+LIMITS.readLines-1;
+   let offset=0;for(let at=1;at<from;at++)offset+=lines[at-1].length+1;
+   let body=lines.slice(from-1,to).join('\n');if(body.length>LIMITS.readChars){body=clip(body,LIMITS.readChars).slice(0,-1);truncated=true;}
+   return{fileId:file.id,path:file.path,startLine:from,endLine:to,totalLines:total,startOffset:offset,truncated,text:body};
+  }),
+  revealSource:wrap(({fileId,path,line})=>{const c=current(),file=resolve(c,{fileId,path});reveal(file.id,bounded(line,1,1e7,'line'));return{fileId:file.id,path:file.path,line};}),
+  patchSource:wrap(({expectedRevision,requestId,edits})=>{
+   const c=current();if(typeof expectedRevision!=='string')throw failure('revision_required','patchSource requires expectedRevision from a recent response.');
+   if(!Array.isArray(edits)||!edits.length||edits.length>LIMITS.patchEdits)throw failure('invalid_request',`Send 1 to ${LIMITS.patchEdits} edits.`);
+   if(JSON.stringify(edits).length>LIMITS.patchChars)throw failure('invalid_request','Patch is too large.');
+   const prepared=edits.map(edit=>{
+    if(edit.find===undefined)return edit;
+    if(typeof edit.find!=='string'||!edit.find)throw failure('invalid_request','find must be nonempty text.');
+    const file=resolve(c,edit),text=read(c,{op:'file.read',id:file.id},expectedRevision).content,at=text.indexOf(edit.find);
+    if(at<0)throw failure('not_found','The find text does not occur in this file.');
+    if(text.indexOf(edit.find,at+1)>=0)throw failure('ambiguous_match','The find text occurs more than once. Extend it or use offsets.');
+    return{fileId:file.id,start:at,end:at+edit.find.length,before:edit.find,after:String(edit.replace??'')};
+   });
+   const id=requestId||crypto.randomUUID();let receipt;beginMutation();try{receipt=c.host.execute({version:1,requestId:id,projectId:c.projectId,expectedRevision,command:{op:'text.patch',edits:prepared}});}finally{endMutation();}
+   if(!receipt.ok)throw failure(receipt.error.code,receipt.error.message);
+   notify(`A browser tool changed ${prepared.length} source ${prepared.length===1?'location':'locations'} in this project. Undo reverts it.`);
+   return{requestId:id,count:receipt.value.count,revision:receipt.revision};
+  }),
+ });
+}
