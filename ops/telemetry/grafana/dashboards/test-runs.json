            "value": "firefox",
            "selected": false
          },
          {
            "text": "webkit",
            "value": "webkit",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0
      }
    ]
  },
  "links": [
