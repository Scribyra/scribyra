        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "rust",
            "value": "rust",
            "selected": false
          },
          {
            "text": "javascript",
            "value": "javascript",
            "selected": false
          },
          {
            "text": "browser",
            "value": "browser",
            "selected": false
          },
          {
            "text": "build",
            "value": "build",
            "selected": false
          },
          {
            "text": "fault_validation",
            "value": "fault_validation",
            "selected": false
          }
        ],
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0
      },
      {
        "name": "browser",
        "label": "Browser",
        "type": "custom",
        "query": "none,chromium,firefox,webkit",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "none",
            "value": "none",
