# Values only; no shell expansion. Self-hosted mode needs no Cloud configuration.
# Cloud mode: root-owned 0600 /etc/scribyra/cloud.username and cloud.ingest-token
# are loaded by systemd LoadCredential. The module sets the runtime file paths.
# Never put a secret value or Grafana management token in this file or Nix config.
SCRIBYRA_CLOUD_OTLP_URL=https://otlp-gateway-prod-eu-central-0.grafana.net/otlp
